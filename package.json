{
  "name": "@norbraet/orbi-dev-tools",
  "version": "0.1.0",
  "description": "Opinionated, reusable repository automation for my projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norbraet/orbi-dev-tools.git"
  },
  "homepage": "https://github.com/norbraet/orbi-dev-tools#readme",
  "bugs": {
    "url": "https://github.com/norbraet/orbi-dev-tools/issues"
  },
  "files": [
    "CHANGELOG.md",
    "bin/",
    "src/",
    "templates/",
    "scripts/bootstrap-github.sh",
    "scripts/sync-github-labels.mjs",
    "scripts/required-status-checks.mjs"
  ],
  "type": "module",
  "bin": {
    "orbi-dev-tools": "bin/orbi-dev-tools.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:package": "node scripts/smoke-package.mjs",
    "lint": "eslint . --max-warnings 0",
    "check": "eslint . --max-warnings 0 && node --test",
    "prepublishOnly": "npm run check && npm run test:package"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  }
}
